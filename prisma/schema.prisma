// BusGuard — Smart College/School Bus Management & Tracking System
// Prisma 7 conventions: datasource url lives in prisma7.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  PARENT
  DRIVER
  ADMIN
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TripDirection {
  PICKUP
  DROPOFF
}

enum TripStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PickupStatus {
  PENDING // row exists (created when trip starts), student has not acted yet
  WAITING // student pressed "I'm waiting"
  PICKED // driver checked them off
  MISSED // marked waiting, bus left, never picked up
  ABSENT // student never marked waiting
}

enum AlertType {
  EMERGENCY
  BREAKDOWN
  ACCIDENT
  DELAY
  OTHER
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum NotificationType {
  BUS_NEARBY
  PICKED_UP
  NO_SHOW
  DELAY
  EMERGENCY
  INFO
}

enum DrivingEventType {
  HARSH_BRAKING
  HARD_ACCELERATION
  OVERSPEED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  driverProfile  DriverProfile?

  // A driver can be rotated across buses over time
  busAssignments BusDriver[]

  // Trips this user is driving
  drivenTrips Trip[] @relation("TripDriver")

  // Alerts this user raised / resolved
  raisedAlerts   EmergencyAlert[] @relation("AlertRaisedBy")
  resolvedAlerts EmergencyAlert[] @relation("AlertResolvedBy")

  notifications Notification[]
  pushSubscriptions PushSubscription[]

  /// Safety events this driver triggered, for the weekly scorecard.
  drivingEvents DrivingEvent[] @relation("DriverEvents")

  @@index([role])
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNo  String   @unique
  department    String?
  yearOfStudy   Int?
  guardianName  String?

  enrollments Enrollment[]
  pickupRecords PickupRecord[]
  guardians    ParentChild[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A parent may watch one or more children.
model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  relation String // MOTHER | FATHER | GUARDIAN

  children ParentChild[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Join: parent <-> student. A student can have several guardians.
model ParentChild {
  id        String        @id @default(cuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model DriverProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo     String   @unique
  licenseExpiry DateTime?
  experienceYr  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Geography: Stop + Route + RouteStop join
// ---------------------------------------------------------------------------

model Stop {
  id      String @id @default(cuid())
  name    String
  address String?
  lat     Float
  lng     Float
  isActive Boolean @default(true)

  routeStops  RouteStop[]
  enrollments Enrollment[]
  stopEvents  StopEvent[]
  pickupRecords PickupRecord[]
  stopApproaches StopApproach[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Route {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)

  routeStops RouteStop[]
  trips      Trip[]
  buses      Bus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// WHY A JOIN TABLE AND NOT `Stop.order`:
/// One stop can sit on several routes, and its position differs per route
/// (Sector 15 is stop 2 on Route A but stop 5 on Route B). The order therefore
/// belongs to the (route, stop) pair — not to the stop itself.
model RouteStop {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId  String
  stop    Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  stopOrder    Int // 1-based position on THIS route
  offsetMeters Int? // cumulative distance from route start, for ETA
  scheduledHHMM String? // e.g. "07:30" for the pickup run

  stopEvents StopEvent[]

  @@unique([routeId, stopId])
  @@unique([routeId, stopOrder])
  @@index([stopId])
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Bus {
  id             String     @id @default(cuid())
  busNumber      String     @unique
  registrationNo String     @unique
  capacity       Int        @default(40)
  model          String?
  status         BusStatus  @default(ACTIVE)

  routeId String?
  route   Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  // Last known position. Written frequently during a trip, so it lives on the
  // bus rather than in a separate table to keep the read cheap.
  currentLat        Float?
  currentLng        Float?
  headingDeg        Float?
  speedKph          Float?
  lastLocationAt    DateTime?
  onboardCount      Int        @default(0)
  isSimulated       Boolean    @default(false)

  busAssignments BusDriver[]
  enrollments    Enrollment[]
  trips          Trip[]
  stopApproaches StopApproach[]
  drivingEvents  DrivingEvent[]
  devices        BusDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// A hardware tracker fitted to a bus.
///
/// The normal installation for a school is a GPS unit on the vehicle rather than
/// a phone in a driver's pocket, and that unit has no login. It authenticates
/// with a bearer token, stored here only as a SHA-256 hash - see
/// `src/lib/device-token.ts` for why a hash and why not bcrypt.
///
/// A separate table rather than a token column on `Bus`, because a bus can carry
/// more than one unit over its life, a unit gets replaced, and replacing one must
/// not revoke the other. `revokedAt` keeps the row so the admin screen can still
/// explain what happened to a token that stopped working, and `lastSeenAt` is how
/// an admin tells "fitted but silent" from "not fitted at all".
model BusDevice {
  id        String @id @default(cuid())
  busId     String
  bus       Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)

  label     String
  tokenHash String @unique

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([busId])
}

/// Driver <-> Bus over time. Not a column on Bus, because drivers rotate and we
/// need to know who drove which bus on which date.
model BusDriver {
  id      String @id @default(cuid())
  busId   String
  bus     Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  driverId String
  driver   User   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  validFrom DateTime  @default(now())
  validTo   DateTime?
  isPrimary Boolean   @default(true)

  @@unique([busId, driverId, validFrom])
  @@index([driverId])
}

// ---------------------------------------------------------------------------
// Enrollment: the student -> bus -> stop assignment
// ---------------------------------------------------------------------------

/// This is an explicit table, not two nullable columns on User, because the
/// assignment is per direction (home->college vs college->home) and per
/// academic year, and history must be retained across years.
model Enrollment {
  id          String        @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  busId       String
  bus         Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  stopId      String
  stop        Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)

  direction   Direction
  academicYear String // e.g. "2026-27"

  isActive Boolean @default(true)

  pickupRecords PickupRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, busId, stopId, direction, academicYear])
  @@index([busId, stopId, direction])
  @@index([studentId])
}

enum Direction {
  PICKUP // home -> institution
  DROPOFF // institution -> home
}

// ---------------------------------------------------------------------------
// Operations: Trip + StopEvent + PickupRecord
// ---------------------------------------------------------------------------

/// One row per bus, per date, per direction. The spine of attendance history.
model Trip {
  id        String         @id @default(cuid())
  busId     String
  bus       Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driverId  String
  driver    User           @relation("TripDriver", fields: [driverId], references: [id], onDelete: Cascade)

  date       DateTime       @db.Date
  direction  TripDirection
  status     TripStatus     @default(SCHEDULED)

  scheduledStart DateTime
  startedAt      DateTime?
  endedAt        DateTime?
  delaySeconds   Int?

  stopEvents   StopEvent[]
  pickupRecords PickupRecord[]
  alerts        EmergencyAlert[]
  stopApproaches StopApproach[]
  drivingEvents  DrivingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([busId, date, direction])
  @@index([date, status])
}

/// Actual arrival at a stop, with the delay it caused. Powers "bus is late".
model StopEvent {
  id          String    @id @default(cuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stopId      String
  stop        Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  routeStopId String?
  routeStop   RouteStop? @relation(fields: [routeStopId], references: [id], onDelete: SetNull)

  arrivedAt   DateTime?
  departedAt  DateTime?
  delaySeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, stopId])
  @@index([tripId])
}

/// THE differentiator table: per student, per trip, per stop.
/// This is what makes BusGuard "student-aware" rather than just a map with a dot.
model PickupRecord {
  id         String        @id @default(cuid())
  tripId     String
  trip       Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stopId     String
  stop       Stop          @relation(fields: [stopId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  status PickupStatus @default(PENDING)

  waitingMarkedAt DateTime?
  pickedAt        DateTime?
  cancelledAt     DateTime?

  /// Set when a guardian confirms, after a MISSED pickup, that their child is
  /// accounted for. The row stays MISSED — the bus really did leave without
  /// them — so this is an acknowledgement layered on top of the fact rather than
  /// a correction of it. Kept separate from `status` so a report can still ask
  /// "how many children were left behind" and, within that, "how many were
  /// confirmed safe", which are two different questions and only one of them is
  /// about the fleet.
  safeMarkedAt   DateTime?
  safeMarkedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, studentId, stopId])
  @@index([tripId, status])
  @@index([stopId, status])
}

/// A geofence ring a bus has already entered on a given run, so the "bus is
/// almost at your stop" alert is sent exactly once per stop per run.
///
/// This is a dedup record, not a log. Without it a bus ticking every few seconds
/// inside the 800 m ring would notify every guardian at that stop four times a
/// minute for the two minutes it spends approaching — and a parent who gets four
/// identical push alerts stops reading them, which is worse than never sending.
///
/// Durability is the point of the table rather than an in-memory set: a deploy
/// mid-run must not re-alert a stop the bus already served, and the simulator's
/// own restart is the same case.
model StopApproach {
  id      String @id @default(cuid())
  busId   String
  bus     Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)
  stopId  String
  stop    Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)

  /// The trip this happened on, when there was one. Null for a simulated bus,
  /// which moves without a `Trip` row so a demonstration never writes fake
  /// attendance history into real reports — the same reason the simulator emits
  /// stop arrivals over the socket instead of into `StopEvent`.
  tripId String?
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)

  /// "PICKUP" or "DROPOFF". The morning run and the afternoon run share every
  /// stop and a parent needs both, so this is part of what makes a row unique
  /// rather than decoration.
  direction Direction

  /// "APPROACHING" (~800 m) or "ARRIVING" (~150 m), from `src/lib/geofence.ts`.
  ring String

  /// The threshold that fired, kept so a future report can tell an "almost there"
  /// from an "at the kerb" without re-deriving the ring from the name.
  radiusMeters Int

  /// The calendar day of the run, so tomorrow's bus may notify again. A date,
  /// not a timestamp: two runs on a day are separated by `direction`, and
  /// nothing here needs sub-day precision.
  date DateTime @db.Date

  notifiedAt DateTime @default(now())

  @@unique([busId, stopId, direction, ring, date])
  @@index([date])
}

/// A moment the driver drove unsafely, detected from the GPS stream by
/// `src/lib/driving.ts` and written by the driving watcher.
///
/// WHY PERSISTED AND NOT JUST COUNTED
///
/// The score is only useful if it can be explained. A manager who is told "this
/// driver scored 45" will ask "what did they do?", and the answer has to be a
/// list of moments — a harsh brake here, an overspeed there — not a number that
/// appeared from nowhere. The events are the audit trail behind the score.
///
/// WHY THE PREVIOUS FIX IS NOT STORED HERE
///
/// Classification needs the fix *before* the current one, but that is a
/// per-bus rolling value the watcher keeps in memory: it is the minimum the
/// decision needs, it is meaningless a moment later, and storing it would be a
/// second, redundant copy of `Bus`'s own last-known position.
model DrivingEvent {
  id           String           @id @default(cuid())
  busId        String
  bus          Bus              @relation(fields: [busId], references: [id], onDelete: Cascade)

  /// Null for a simulated bus, which moves without a driver to score.
  driverId     String?
  driver       User?            @relation("DriverEvents", fields: [driverId], references: [id], onDelete: SetNull)

  tripId       String?
  trip         Trip?            @relation(fields: [tripId], references: [id], onDelete: SetNull)

  type         DrivingEventType

  /// The speed change that triggered it, or the speed itself for overspeed.
  magnitudeKph Float

  lat          Float?
  lng          Float?

  at           DateTime

  createdAt    DateTime         @default(now())

  @@index([driverId, at])
  @@index([busId, at])
}

// ---------------------------------------------------------------------------
// Alerts + Notifications
// ---------------------------------------------------------------------------

model EmergencyAlert {
  id       String      @id @default(cuid())
  tripId   String?
  trip     Trip?       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  busId    String
  type     AlertType   @default(EMERGENCY)
  message  String
  lat      Float?
  lng      Float?
  status   AlertStatus @default(OPEN)

  raisedById String
  raisedBy   User   @relation("AlertRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  resolvedById String?
  resolvedBy   User?  @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  // When an admin first saw the alert, and what actually happened. Both are
  // needed for the incident trail: "OPEN" alone cannot tell whether nobody
  // was looking or somebody was looking and did nothing.
  acknowledgedAt DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([busId])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType @default(INFO)
  title  String
  body   String
  data   Json?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

/// A browser's push subscription, so a notification reaches a phone with the
/// app closed.
///
/// One row per browser, not per user: the same person opening BusGuard on a
/// tablet and a phone has two endpoints, and unregistering one must not
/// silence the other. Rows are pruned automatically when the push service
/// reports an endpoint as gone (see `src/lib/push.ts`), because an expired
/// endpoint that is never cleaned up is a permanent, invisible send failure.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service's URL for this browser. Unique, because two rows with the
  /// same endpoint are the same subscription and would double every message.
  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Server-side cache of route durations from OSRM so we stay inside the
/// public API's rate limit.
model EtaCache {
  id       String @id @default(cuid())
  cacheKey String @unique
  seconds  Int
  meters   Int?
  source   String // "osrm" | "haversine"

  /// The road-following polyline, as `[lng, lat]` pairs, exactly as OSRM
  /// returned it.
  ///
  /// Storing the geometry is the whole reason the cache exists for a route
  /// lookup. Without it, a cache hit can only return the distance and duration,
  /// and the caller has to fall back to straight lines between stops — so the
  /// map would draw real roads on the first render and crude straight lines for
  /// the next six hours, while still reporting the road distance. Caching the
  /// answer to a question and then answering a *different* question on the
  /// second render is worse than not caching at all.
  ///
  /// Null for single-leg lookups (which ask for `overview=false`) and for
  /// haversine fallbacks, neither of which has any geometry to keep.
  geometry Json?

  computedAt DateTime @default(now())

  @@index([computedAt])
}
