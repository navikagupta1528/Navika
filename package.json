{
  "name": "navika",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "tsx server.ts --prod",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup:db": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1",
    "test": "vitest run",
    "setup": "npm run setup:db && npm run db:migrate && npm run db:seed",
    "smoke": "tsx scripts/smoke-socket.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:admin": "tsx scripts/smoke-admin.ts",
    "smoke:tracking": "tsx --conditions=react-server scripts/smoke-tracking.ts",
    "check:osrm": "tsx --conditions=react-server scripts/check-osrm.ts",
    "map:tour": "tsx --conditions=react-server scripts/map-tour.ts",
    "check:runtime-tree": "tsx scripts/check-runtime-tree.ts",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/start-db.ps1",
    "smoke:all": "npm run smoke && npm run smoke:auth && npm run smoke:admin && npm run smoke:tracking",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docker:build": "docker build -t navika .",
    "docker:run": "docker run --rm -p 3010:3010 --env-file .env navika"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
