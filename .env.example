# BusGuard — environment template
# Copy to .env and fill in. Never commit .env.
#
# Fastest path: run  npm run setup:db
# That script creates the busguard role and database, and writes .env for you.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE YOU DEPLOY. The three NEXT_PUBLIC_* values below are inlined
# into the JavaScript bundle at BUILD time, not read per request. Changing one on
# a running server does nothing until you rebuild and redeploy. This is the most
# common reason a deployed map comes up blank or push silently stops working,
# and no error message ever points at it.
# ---------------------------------------------------------------------------

# Local PostgreSQL. Change user/host/port to match your machine.
DATABASE_URL="postgresql://busguard:your_password@127.0.0.1:5432/busguard?schema=public"

# 32+ character random string used to sign session cookies.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this logs every user out. It is not a way to fix a compromised
# database; do that by rotating the DATABASE_URL password instead.
AUTH_SECRET=""

# HTTP port. Change this if 3000 is already taken on your machine.
PORT=3000

# Public origin, used for absolute URLs in notifications. Must agree with PORT.
# In production this is the deployed https origin with no trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Raster tile template for the MapLibre map. Defaults to OpenStreetMap's public
# server, which is fine for development and is explicitly meant for projects at
# this scale. Point it at a hosted provider for a real deployment, because the
# OSM tile policy does not cover production traffic.
#   MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
#   Stadia:   https://tiles.stadiamaps.com/tiles/alidade_smooth/256/{z}/{x}/{y}.png?api_key=YOUR_KEY
# A production build left on the default still renders, but warns in the browser
# console on every map load: `mapTileNotice` in src/lib/map-tiles.ts.
# NEXT_PUBLIC_MAP_TILE_URL=

# OSRM routing server for road-accurate ETA. The public demo instance needs no
# API key but is rate limited, so results are cached in the EtaCache table.
# Self-host for production: https://github.com/Project-OSRM/osrm-backend
OSRM_URL="https://router.project-osrm.org"

# ---- Scaling ---------------------------------------------------------------
# Socket.IO broadcasts to one process's clients on its own. Run two instances and
# that stops being one fleet: a driver on instance A moves a bus and a parent on
# instance B watches a frozen map, with every page still rendering normally.
#
# Set this to share broadcasts across instances. Unset (the default) is a fully
# supported single-instance configuration, and is what render.yaml ships.
#   redis://localhost:6379
#   rediss://user:pass@host:6380/0   # TLS
# The mode in use is reported by /api/health under "realtime".
# REDIS_URL=

# ---- Web push -------------------------------------------------------------
# Generate a matched pair with:
#   npx web-push generate-vapid-keys
#
# With these three empty, BusGuard still runs: push.ts treats missing keys as
# "this deployment does not do push" and returns quietly, and the notifications
# page keeps working over the in-app inbox. So a blank value is a valid,
# supported configuration, not a misconfiguration to be chased down.
#
# The public key ships to the browser and is fine to expose. The private key
# must never leave the server.
#
# Rotating either key invalidates every existing subscription with no error:
# the browser keeps the old public key and every send fails. Delete the
# PushSubscription rows when you rotate.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Web push requires a contact address. Browsers reject a subscription whose
# VAPID subject is absent or malformed.
VAPID_SUBJECT="mailto:you@example.com"
