# Navika — local development environment
# Copy to .env and fill in. Never commit .env.
#
# Fastest path: run  npm run setup:db
# That script creates the navika role and database, and writes .env for you.

# Local PostgreSQL. Change user/host/port to match your machine.
DATABASE_URL="postgresql://navika:your_password@127.0.0.1:5432/navika?schema=public"

# 32+ character random string used to sign session cookies.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# HTTP port. Change this if 3000 is already taken on your machine.
PORT=3000

# Public origin, used for absolute URLs in notifications. Must agree with PORT.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Raster tile template for the MapLibre map. Defaults to OpenStreetMap's public
# server, which is fine for development and is explicitly meant for projects at
# this scale. Point it at a hosted provider for a real deployment, because the
# OSM tile policy does not cover production traffic.
#   MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_URL=

# OSRM routing server for road-accurate ETA. The public demo instance needs no
# API key but is rate limited, so results are cached in the EtaCache table.
# Self-host for production: https://github.com/Project-OSRM/osrm-backend
OSRM_URL="https://router.project-osrm.org"

# Web push (Phase 4). Generate with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
